#!/bin/bash

##
# Pre-Commit Hook - Version Validation
#
# This hook runs before a commit is made and:
# 1. Validates commit message format (optional)
# 2. Checks version consistency
# 3. Ensures all version references match
##

# Exit on error
set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# Check if this is a version bump commit (skip validation)
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "$COMMIT_MSG_FILE" ]; then
  COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
  if [[ "$COMMIT_MSG" == *"chore: bump version"* ]] || [[ "$COMMIT_MSG" == *"[skip-version]"* ]]; then
    echo "⏭️  Skipping validation for version bump commit"
    exit 0
  fi
fi

# Validate commit message format (optional - can be disabled in config)
# Uncomment to enforce conventional commits
# if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|chore|major|minor|patch):"; then
#   echo -e "${YELLOW}⚠️  Warning: Commit message doesn't follow conventional format${NC}"
#   echo "   Expected: <type>: <description>"
#   echo "   Types: feat, fix, docs, style, refactor, perf, test, chore"
# fi

# Check for large files
echo "  Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only | xargs -I {} du -k {} 2>/dev/null | awk '$1 > 1024 {print $2}')
if [ ! -z "$LARGE_FILES" ]; then
  echo -e "${YELLOW}⚠️  Warning: Large files detected (>1MB):${NC}"
  echo "$LARGE_FILES"
fi

# Check for merge conflicts markers
echo "  Checking for merge conflicts..."
CONFLICT_MARKERS=$(git diff --cached --name-only | xargs grep -l "^<<<<<<< \|^======= \|^>>>>>>> " 2>/dev/null || true)
if [ ! -z "$CONFLICT_MARKERS" ]; then
  echo -e "${RED}❌ Error: Merge conflict markers found in:${NC}"
  echo "$CONFLICT_MARKERS"
  exit 1
fi

# Check for console.log statements (warning only)
# echo "  Checking for debug statements..."
# DEBUG_STATEMENTS=$(git diff --cached --name-only '*.js' | xargs grep -n "console\.log\|debugger" 2>/dev/null || true)
# if [ ! -z "$DEBUG_STATEMENTS" ]; then
#   echo -e "${YELLOW}⚠️  Warning: Debug statements found:${NC}"
#   echo "$DEBUG_STATEMENTS"
# fi

echo -e "${GREEN}✓ Pre-commit checks passed${NC}"

exit 0
